# ---------------------------------------------------------------
# Database — matches docker-compose.yml credentials exactly.
# Alembic migration 0001 applies against this URL.
# ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://dossier:dossier@localhost:5432/dossier

# ---------------------------------------------------------------
# Langfuse — Cloud free tier per CONTEXT.md D-16.
# Get keys at: https://cloud.langfuse.com → Project Settings → API Keys.
# ---------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------
# OpenRouter — sole LLM gateway per PROJECT.md locked decisions.
# Not used in Phase 1 beyond being present for later phases.
# Get key at: https://openrouter.ai/keys
# ---------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------
# Clerk — auth per CONTEXT.md D-24 / AUTH-01 (added in Plan 02-03).
# Get keys at: https://dashboard.clerk.com → your project → API Keys.
# JWKS URL format: https://<your-clerk-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# ---------------------------------------------------------------
CLERK_JWKS_URL=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------
# Dev-only auth bypass — when set to a non-empty Clerk user_id string,
# require_clerk_user_id returns that string verbatim instead of verifying a JWT.
# NEVER set this in deployed envs. Only for running the backend locally before
# Clerk keys are wired up. Leave blank to enforce real Clerk auth.
# ---------------------------------------------------------------
DOSSIER_AUTH_DEV_BYPASS=

# ---------------------------------------------------------------
# Investigation tool wrappers (Plan 02-04).
# Three external data sources shipped in Phase 2 per CONTEXT.md D-11.
# Parallel fan-out + NewsAPI/Crunchbase added in Phase 3 per D-12.
# ---------------------------------------------------------------

# Exa — primary web search per CONTEXT.md D-11 (Tavily rejected per CLAUDE.md — hides spans).
# Get key at: https://dashboard.exa.ai/api-keys.
EXA_API_KEY=

# GitHub — founder repos/activity per INVEST-02 / CONTEXT.md D-11.
# 5000 req/hr tokened vs. 60 req/hr unauthed (ARCHITECTURE.md §10).
# Generate PAT at: https://github.com/settings/tokens (scopes: public_repo, read:user).
# Leave blank for local dev if the 60 req/hr unauthed rate is enough.
GITHUB_TOKEN=

# Firecrawl — deep-crawl seed URL per CONTEXT.md D-11 / D-13.
# Budget: ≤1 crawl per investigation (500 free credits/mo must stretch to Phase 4 eval).
# Get key at: https://www.firecrawl.dev/app/api-keys.
FIRECRAWL_API_KEY=
