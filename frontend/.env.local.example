# Frontend env vars. Copy to .env.local and fill in.
# NEXT_PUBLIC_* are browser-visible; others are server-only.

# Clerk — per UI-SPEC §1 + CONTEXT.md D-24.
# Get keys at: https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/investigations
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/investigations

# Backend — FastAPI URL; route handlers proxy via lib/api-client.ts (D-23).
# Local dev: uvicorn on port 8000 (backend/.env + Plan 02-03).
# Phase 3 replaces with the AWS Function URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
