# Frontend env vars. Copy to .env.local and fill in.
# NEXT_PUBLIC_* are browser-visible; others are server-only.

# Clerk — per UI-SPEC §1 + CONTEXT.md D-24.
# Get keys at: https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Sign-in/sign-up URLs: leave UNSET to use Clerk's hosted Account Portal
# (matches UI-SPEC §1 "Sign-in / sign-up use Clerk HOSTED pages"). Setting
# these to local paths like /sign-in causes a 404 redirect loop because we
# do not ship a local sign-in page. If you later add a custom sign-in page,
# uncomment and set to the local route.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/investigations
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/investigations

# Backend — FastAPI URL; route handlers proxy via lib/api-client.ts (D-23).
# Local dev: uvicorn on port 8000 (backend/.env + Plan 02-03).
# Phase 3 replaces with the AWS Function URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
